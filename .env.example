# Hopscotch API key (https://platform.hopscotchlabs.ai). Looks like ub_live_...
HOPSCOTCH_API_KEY=

# Must be a model from a Canadian lab (Cohere). Run `php bin/models.php` to
# list the ones your key can call.
HOPSCOTCH_MODEL=cohere/command-a-03-2025

# Optional. A smaller Canadian model for wording the search and suggesting
# follow-up questions. Defaults to cohere/command-r7b-12-2024.
# HOPSCOTCH_FAST_MODEL=

# Only change this to point at the local stand-in: http://localhost:8787
# HOPSCOTCH_BASE_URL=https://api.hopscotchlabs.ai/v1

# Optional. Unsplash access key (https://unsplash.com/developers) for the
# photos behind the example questions. Without it the cards show gradients.
UNSPLASH_ACCESS_KEY=

# Optional. The site's public address, used in link previews. Defaults to
# https://canada-gov.canner.app
# SITE_URL=
